# Copia este archivo a .env y pon tus valores: cp .env.example .env
# .env no va a Git ni a la imagen Docker; este archivo sí va a Git, sin secretos.
OBSERVATORIO_TOKEN=
OBSERVATORIO_TIMEOUT=10
OBSERVATORIO_RETRIES=3
# La base de datos de `docker compose up -d db`. La contraseña es la de desarrollo de
# compose.yaml; con una base de verdad, la tuya va solo en .env.
OBSERVATORIO_DATABASE_URL=postgresql+psycopg://observatorio:observatorio@127.0.0.1:5432/observatorio
